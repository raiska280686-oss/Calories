{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "runtime": "@vercel/python@4.3.1"
    }
  },
  "rewrites": [
    { "source": "/webhook", "destination": "/api/webhook" },
    { "source": "/off", "destination": "/api/off" },
    { "source": "/auth", "destination": "/api/auth" },
    { "source": "/data", "destination": "/api/data" }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ],
  "cleanUrls": true
}
