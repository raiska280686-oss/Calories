BOT_TOKEN=your_telegram_bot_token
WEBHOOK_SECRET=your_random_secret
WEBHOOK_BASE_URL=https://your-app.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_publishable_key
# Приватний ключ підпису Supabase (Project Settings -> API -> JWT Settings -> Signing Keys -> Reveal).
# Підтримує PEM, base64(PEM), base64(DER) або JSON {"private_key": "..."}.
# Для старих проєктів з legacy JWT Secret сюди кладуть сам секрет (підпис HS256).
SUPABASE_JWT_SECRET=your_signing_private_key_or_legacy_secret
# необовʼязково: Key ID активного ключа (якщо не заданий — береться з JWKS)
SUPABASE_JWT_KID=
